# ==================== SECRETS (keep these in .env) ====================
# These are sensitive values that should NEVER be in version control
# Copy this file to .env and fill in your actual secret values

# Google API Key for Gemini
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Session signing secret — signs the login session cookie.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SESSION_SECRET is read first; this historical name is the fallback.
# Changing it invalidates every existing session, so keep it stable.
CHAINLIT_AUTH_SECRET=your_chainlit_auth_secret_here

# Google OAuth Credentials
# Get these from: https://console.developers.google.com/apis/credentials
# Follow instructions in docs/GOOGLE_OAUTH_SETUP.md
OAUTH_GOOGLE_CLIENT_ID=your_oauth_client_id_here.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your_oauth_client_secret_here

# Gmail Add-on — OAuth Client ID for OIDC token audience verification
# Same GCP project as above; create via APIs & Services → Credentials
# Optional for Phase 1 (domain restriction via hd claim is sufficient)
GOOGLE_ADDON_CLIENT_ID=


# ==================== CONFIGURATION (defaults in config/settings.py) ====================
# These are non-secret configuration values with defaults in config/settings.py
# View all defaults in: config/settings.py
# Uncomment any of these to override the defaults

# Root Data Directory for Persistent Storage (default: ./data locally, /app/data in production)
# DATA_DIR=./data

# Directory for importing CSVs
# IMPORT_DIR=./data/import

# Gemini Embedding Model
# EMBEDDINGS_MODEL=gemini-embedding-2-preview
# EMBEDDINGS_LOCATION=us-central1

# PostgreSQL Database URLs (Required)
# Points to production DB even for local dev
# App database (dashboard, RFQ data, chat transcript) — async
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/dbname
# LangGraph checkpointer/store — sync driver
# CHECKPOINT_DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# OAuth Domain Restriction (default: mooball.net,eagle-exports.com)
# OAUTH_ALLOWED_DOMAINS=yourdomain.com,anotherdomain.com

# ==================== LLM Configuration ====================
#
# Measured 2026-09-23 (thinking=LOW, 7 realistic tasks, global endpoint):
#   3.5-flash-lite  1.20s/call  ~$0.54/1k   fastest AND cheapest
#   3.6-flash       3.10s       ~$2.25      fastest full-Flash, tightest tail
#   3.5-flash       3.32s       ~$5.93      most expensive, no speed gain
#   3.8-flash       3.74s       ~$1.34      uses ~4x fewer thinking tokens
#   3.7-flash       7.01s       ~$1.64      regression — avoid
#
# 3.6/3.7/3.8 share IDENTICAL per-token pricing ($0.75/$3.75 until 2026-12-31,
# then $1.50/$7.50). Cost differences between them are thinking tokens, not
# price. Every model scored 10/10 on the department-grouping benchmark, so this
# is a speed/cost choice at *unverified*-equal quality.
#
# Gemini 3.x is served from the `global` endpoint only — regional locations
# return 404 for it. Do not pin GOOGLE_CLOUD_LOCATION to a region without
# re-checking availability.
#
# 3.7-flash and 3.8-flash reject thinking_level=MINIMAL (400); `low` is the only
# level all five models accept.
#
# Everything below is optional. Built-in defaults (config/settings.py):
#   DEFAULT_MODEL=gemini-3-flash-preview   SUPERVISOR_MODEL=gemini-3.5-flash-lite
#   SYNC_MODEL=gemini-3.5-flash-lite       MODEL_LADDER=<see Failover below>
# The heavily-commented value on each line is the recommended production
# setting, which differs from the default where the default is a poor choice.

# Catch-all for anything not overridden below.
# DEFAULT_MODEL=gemini-3.6-flash

# Agents — interactive, so tail latency matters more than cost.
# PROCUREMENT_AGENT_MODEL=gemini-3.6-flash
# GENERAL_AGENT_MODEL=gemini-3.6-flash
# RESEARCH_AGENT_MODEL=gemini-3.6-flash
# BROWSER_AGENT_MODEL=gemini-3.6-flash
# SYSADMIN_AGENT_MODEL=gemini-3.5-flash-lite
# Routing only — cheapest model that works.
# SUPERVISOR_MODEL=gemini-3.5-flash-lite

# Pipelines — background, so prefer cheaper over faster.
# QUOTE_PIPELINE_MODEL=gemini-3.8-flash
# QUOTE_CLASSIFY_MODEL=gemini-3.5-flash-lite
# QUOTE_EXTRACT_MODEL=gemini-3.8-flash
# QUOTE_INTERPRET_MODEL=gemini-3.8-flash
# RFQ_CREATION_PIPELINE_MODEL=gemini-3.8-flash
# RFQ_CREATION_EXTRACT_MODEL=gemini-3.8-flash
# VISION_EXTRACTION_MODEL=gemini-3.8-flash

# Background sync loops (Gmail / NetSuite / maintenance). Keep this distinct
# from the interactive models so our own bulk work cannot contend with live chat
# for the same quota.
# SYNC_MODEL=gemini-3.5-flash-lite

# Failover. One ordered ladder, most capable first. A model's fallbacks are the
# entries *below* it, so every failover is an incremental step down instead of a
# cliff (a Pro model used to fall straight to flash-lite).
#
# 3.7-flash is deliberately absent: measured 7.01s mean wall vs 3.10s for
# 3.6-flash with no measured quality gain. 3.6/3.7/3.8 share identical per-token
# pricing, so this is a capability ladder, not a price one.
# A model NOT on the ladder gets the cheapest rung only, so a failover can never
# cost more than the primary did.
# The bottom rung has no fallback: a 429 on 3.5-flash-lite is terminal.
# MODEL_LADDER=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
#
# Deprecated 2026-09-26 — replaced by MODEL_LADDER, and ignored if set:
#   FALLBACK_MODEL, FALLBACK_CHAIN

# Retry policy. ChatGoogleGenerativeAI defaults max_retries to 6, which is where
# the endless "Agent working..." spinner came from. Google's guidance for
# real-time workloads is to fail fast rather than retry indefinitely.
# LLM_MAX_RETRIES=2
# LLM_SDK_RETRY_ATTEMPTS=2
# Budget for the WHOLE call across all candidates. Enforced as a per-attempt
# HTTP timeout of min(remaining, LLM_REQUEST_TIMEOUT_MS), so a single attempt
# cannot outlive it. 90s because the slowest *successful* call observed in prod
# was 62.6s — a 45s budget would have turned that success into a failure.
# LLM_MAX_ATTEMPT_SECONDS=90
# LLM_REQUEST_TIMEOUT_MS=90000

# Vertex service tiers — leave empty for Standard.
#   SERVICE_TIER_PRIORITY -> not preempted at peak load; overflow is served at
#                            Standard instead of failing. Premium price.
#                            Requires a Tier 2/3 project. NOT observable in
#                            responses, so a downgrade is silent.
#   SERVICE_TIER_FLEX     -> ~50% cheaper, slower; for latency-tolerant work.
# Values must be the proto enum names. Measured 2026-09-24: in a quiet period
# the tiers are within ~7% of each other, so enable one at a time and judge from
# llm_call_log over real load, not from a benchmark.
# INTERACTIVE_SERVICE_TIER=
# SYNC_SERVICE_TIER=

# LLM telemetry -> llm_call_log (best-effort; never fails a request).
# LLM_TELEMETRY_ENABLED=1
# LLM_TELEMETRY_RETENTION_DAYS=30

# LangGraph Execution Limit (default: 50)
# GRAPH_RECURSION_LIMIT=50

# Temporary files folder (default: .files)
# TEMP_FILES_FOLDER=.files

# Gmail Mailbox Sync (default: enabled, every 300s)
# Set GMAIL_SYNC_ENABLED=false to disable background Gmail polling
# GMAIL_SYNC_ENABLED=true
# GMAIL_SYNC_INTERVAL=300

# Maintenance / Pruning (default: enabled, every 24h, 90-day retention)
# MAINTENANCE_ENABLED=true
# MAINTENANCE_INTERVAL=86400
# CHECKPOINT_RETENTION_DAYS=90
# ATTACHMENT_RETENTION_DAYS=90

# Production Database URL (for local scripts targeting Railway)
# PROD_DATABASE_URL=postgresql://user:password@hostname:port/dbname

# Dashboard Context TTL in seconds (default: 1800 = 30 minutes)
# DASHBOARD_CONTEXT_TTL=1800

# Max file upload size in MB (default: 100)
# MAX_FILE_SIZE_MB=100
