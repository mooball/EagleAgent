# Docker Local Testing Environment Variables
# Copy this file to .env.docker and fill in actual values
# DO NOT commit .env.docker to version control

# ----------------------------------------------------------------
# Copy these from your .env file
# ----------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account-key.json
# Session signing secret — signs the login session cookie.
# SESSION_SECRET is read first; this historical name is the fallback.
# Changing it invalidates every existing session.
CHAINLIT_AUTH_SECRET=your-64-char-auth-secret-here
OAUTH_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=GOCSPX-your-oauth-client-secret
OAUTH_ALLOWED_DOMAINS=yourdomain.com

# ----------------------------------------------------------------
# Docker-specific configuration (use as-is)
# ----------------------------------------------------------------

# GCP Project (test project for local Firestore emulator)
GOOGLE_PROJECT_ID=test-project

# Deployment
PORT=8080

# Database — PostgreSQL is required (JSONB + asyncpg). Point this at a Postgres
# instance; there is no SQLite fallback any more.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/eagleagent

# Storage  
GCP_BUCKET_NAME=eagleagent
TEMP_FILES_FOLDER=/tmp/files

# Per-agent model overrides (optional, defaults to DEFAULT_MODEL)
# BROWSER_AGENT_MODEL=gemini-2.5-flash
# GENERAL_AGENT_MODEL=gemini-3-flash-preview
# PROCUREMENT_AGENT_MODEL=gemini-3-flash-preview
# SUPERVISOR_MODEL=gemini-3-flash-preview

# Firestore Emulator
# Mac/Windows: use host.docker.internal
# Linux: use 172.17.0.1
FIRESTORE_EMULATOR_HOST=host.docker.internal:8686

# ----------------------------------------------------------------
# Vertex AI uses GOOGLE_APPLICATION_CREDENTIALS above
# ----------------------------------------------------------------
